# ---- Varagh (ورق) ---------------------------------------------------
# Copy to .env and adjust. NEVER commit .env (it is git-ignored).
# ---------------------------------------------------------------

# Database ------------------------------------------------------------
POSTGRES_USER=varagh
POSTGRES_PASSWORD=varagh
POSTGRES_DB=varagh
DATABASE_URL=postgresql+psycopg://varagh:varagh@db:5432/varagh
TEST_DATABASE_URL=postgresql+psycopg://varagh:varagh@db:5432/varagh_test

# Images (override when Docker Hub is not reachable from your network) --
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim

# App -----------------------------------------------------------------
APP_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=Asia/Tehran
# Directory holding the holiday list (holidays_jalali.json).
DATA_DIR=./data
# Optional HTTP Basic auth (single user). Leave empty to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# AI (entirely optional; the app works without it) --------------------
# AI_PROVIDER: anthropic | openai | custom | (empty = AI disabled)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# Custom provider (AI_PROVIDER=custom): any endpoint that speaks JSON.
# AI_CUSTOM_URL: the full endpoint URL.
# AI_CUSTOM_METHOD: json | openai | anthropic | prompt
# AI_CUSTOM_HEADERS: extra headers, e.g. "X-Api-Key: abc, X-Tenant: personal"
AI_CUSTOM_URL=
AI_CUSTOM_METHOD=json
AI_CUSTOM_HEADERS=

# Notifications: SMTP email ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Notifications: webhook (Slack/Mattermost compatible) ---------------
WEBHOOK_URL=
WEBHOOK_FORMAT=slack
